{"kind":"table","sheet":"Assembly review","address":"A1:C26","rows":26,"cols":3,"values":[[null,null,null],["Assembly details and evidence limits",null,null],[null,null,null],["Detail","Value","Evidence status"],["Left synthesis flank (5′ to 3′)","GTTCCTGCGGCCGCACGCGT | 20 bp | reference 125–144","Sequence verified"],["Right synthesis flank (5′ to 3′)","GAGCTCGGGCTGGGCATAAAAGTCAGGGCA | 30 bp | reference 727–756","Sequence verified"],["Actual retained overlaps","Left: 15 bp (125–139); right: 25 bp (732–756). Site-restoration bases supplied by insert.","Cut positions verified"],["Fragment composition","20-bp left flank + exact 500-bp parent + 30-bp right flank = 550 bp. Both flanks in forward construct direction.","Sequence verified"],["Backbone preparation","MluI/SacI digest of backbone only; remove original enhancer-containing fragment. Do not digest the synthetic inserts.","Vendor method review"],["Assembly","Two-fragment homology assembly; complete MluI/SacI sites restored. Right synthesis flank is not reverse-complemented.","Digital simulation passed"],["Expected plasmid","4,738 bp; reference 145–726 replaced by 500-bp parent, all other reference bases unchanged.","Sequence verified"],["ITR-to-ITR span","2,141 bp including long-annotated repeats; 2,130 bp using alternative right-ITR endpoint.","Endpoint annotation review"],["Parent 140 restriction site","One internal SacI at enhancer 392–397. Compatible with separate-backbone digestion; changes final diagnostic digest.","Sequence verified"],["Left-arm ITR homology","Six terminal left-ITR bases occur in arm; longest exact tract elsewhere is 14 bp. Physical assembly efficiency not established.","Vendor feasibility review"],["Protected cassette","All promoter/linker, SYFP2, WPRE/linker, barcode, polyA and ITR reference bases outside enhancer retained.","Sequence verified"],["Named-feature limits","Exact minBG endpoints, WPRE3 terminal convention, BarcodeS name mapping and right-ITR endpoint remain partly inferred.","Annotation review"],["Existing barcode","AGCAATTA retained identically in all three. Keep constructs separate for initial cloning QC.","No unique pooled IDs"],["Laboratory validation","Verify complete insert, junctions, full plasmid, barcode region and ITR integrity after cloning.","Not yet performed"],[null,null,null],["Fragment ID","SHA256 of supplied 550-bp fragment","Nearest gene"],["MG_P140_parent500","4d0e09f8b7f87247121efb077f90ef0d9517abc3e758f69b6f2a4b9ee2d3f980","PRSS56"],["MG_P25_parent500","2300ae749f38e28ea9eb3183c1a865d0c92950f93320d73279f1c8d0b97e610e","ADGRA2"],["MG_P779_parent500","feb62fc753207551ca47ec50dfb9925146d9a981348ae1094650351cb7375c04","TNRC17"],[null,null,null],["Reference: https://www.addgene.org/236600/sequences/ (sequence 472831).",null,null],["Enhancer-boundary evidence: Hunker et al., Neuron 2025, Table S1 row 30; DOI 10.1016/j.neuron.2025.04.035.",null,null]]}
